{
    "name": "reedificando-o-altar/api",
    "description": "API do site do Ministério Reedificando o Altar",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -d extension=gd -d extension=sodium -S localhost:8080 -t public public/index.php",
        "setup": "php -d extension=gd -d extension=sodium bin/setup-db.php --seed",
        "migrate-legacy": "php -d extension=gd -d extension=sodium bin/migrate-legacy.php"
    }
}
